{
  "rewrites": [
    { "source": "/api", "destination": "/api/index.json" },
    { "source": "/api/products", "destination": "/api/products.json" },
    { "source": "/api/products/:slug", "destination": "/api/products/:slug.json" },
    { "source": "/api/categories", "destination": "/api/categories.json" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
